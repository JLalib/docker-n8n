      "parameters": {
        "jsCode": "// --- Normalizador Universal de Facturas (Corregido) ---\n// Entrada: $input.first().json.content (string con un JSON de la IA)\n// Salida: Un objeto con los datos estructurados para Airtable y un mensaje para Telegram.\n\nconst rawContent = $input.first()?.json?.content ?? '{}';\nlet invoiceData = {};\n\ntry {\n  // Intenta parsear el contenido. La IA a veces devuelve el JSON con texto adicional.\n  const jsonMatch = rawContent.match(/\\{.*\\}/s);\n  if (!jsonMatch) throw new Error('No se encontró un JSON válido en la respuesta de la IA.');\n  invoiceData = JSON.parse(jsonMatch[0]);\n\n  // --- FUNCIÓN MEJORADA PARA CONVERTIR TEXTO A NÚMERO ---\n  const cleanAndParseFloat = (text) => {\n    if (typeof text !== 'string') return 0;\n    // Elimina todo lo que no sea un dígito o un punto decimal.\n    const cleanedText = text.replace(/[^0-9.]+/g, '');\n    const number = parseFloat(cleanedText);\n    return isNaN(number) ? 0 : number;\n  };\n\n  // Asigna 'N/A' (No aplica) a campos vacíos para consistencia\n  const fields = [\n    'emisor', 'cliente', 'id_fiscal_emisor', 'id_fiscal_cliente',\n    'numero_factura', 'fecha_emision', 'fecha_vencimiento', 'subtotal',\n    'impuestos', 'total', 'moneda', 'concepto'\n  ];\n\n  for (const field of fields) {\n    invoiceData[field] = invoiceData[field] || 'N/A';\n  }\n\n  // Convierte los montos usando la nueva función\n  const subtotalNum = cleanAndParseFloat(invoiceData.subtotal);\n  const impuestosNum = cleanAndParseFloat(invoiceData.impuestos);\n  const totalNum = cleanAndParseFloat(invoiceData.total);\n\n  // Prepara el mensaje para Telegram con formato de número correcto\n  const formatCurrency = (num) => new Intl.NumberFormat('es-DO', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);\n\n  const telegramMessage = `\n🧾 <b>Resumen de Factura</b>\n\n🏢 <b>Emisor:</b> ${invoiceData.emisor}\n👤 <b>Cliente:</b> ${invoiceData.cliente}\n\n🔢 <b>Factura #:</b> <code>${invoiceData.numero_factura}</code>\n📅 <b>Fecha:</b> ${invoiceData.fecha_emision}\n\n💰 <b>Subtotal:</b> ${formatCurrency(subtotalNum)} ${invoiceData.moneda}\n💸 <b>Impuestos:</b> ${formatCurrency(impuestosNum)} ${invoiceData.moneda}\n<b>✅ Total: ${formatCurrency(totalNum)} ${invoiceData.moneda}</b>\n\n📝 <b>Concepto:</b> ${invoiceData.concepto}\n  `.trim();\n\n  // Estructura el objeto final de salida con los números correctos\n  return [{\n    json: {\n      telegramMessage,\n      airtableData: {\n        fecha: invoiceData.fecha_emision,\n        emisor: invoiceData.emisor,\n        id_fiscal: invoiceData.id_fiscal_emisor,\n        ncf: invoiceData.numero_factura,\n        itbis: impuestosNum,\n        subtotal: subtotalNum,\n        total: totalNum,\n        concepto: invoiceData.concepto,\n        ocrCompleto: rawContent\n      }\n    }\n  }];\n\n} catch (e) {\n  // Manejo de errores\n  return [{\n    json: {\n      telegramMessage: `❌ <b>Error al procesar la factura:</b>\\n${e.message}`,\n      airtableData: {},\n      error: e.message,\n      originalContent: rawContent\n    }\n  }];\n}"
      },
