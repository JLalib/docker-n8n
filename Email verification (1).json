    {
      "parameters": {
        "jsCode": "// n8n Code Node - Simple Email Verification Parser\n// Extracts just the essential fields from MailTester.ninja response\n\nfor (const item of $input.all()) {\n  // Parse the JSON string if needed\n  let data;\n  \n  if (typeof item.json.data === 'string') {\n    try {\n      data = JSON.parse(item.json.data);\n    } catch (error) {\n      data = item.json;\n    }\n  } else {\n    data = item.json;\n  }\n  \n  // Extract only the fields you want\n  item.json = {\n    code: data.code || '',\n    message: data.message || '',\n    email: data.email || '',\n    domain: data.domain || '',\n    user: data.user || ''\n  };\n}\n\nreturn $input.all();"
      },
